#!/usr/bin/env bash
#
# cap — call-aware process throttler for macOS
#
#   cap call          quiet things for a call: pause background daemons,
#                       cpu-cap heavy apps, quit sync clients
#   cap off           release everything (resume, relaunch sync clients, drop caps)
#   cap status        show what is paused / capped / quit
#   cap suggest [sec] list current CPU/RAM/net hogs; with [sec], loop every sec
#   cap add <pat>     remember a process/app (substring) to cap from now on
#   cap list          show what call mode does vs. protects
#   cap setup         one-time: install a sudoers drop-in so call/off need no password
#
# Quitting your own apps needs no sudo. Pausing system daemons needs root —
# run `cap setup` once to do call/off without a password prompt.
#
set -uo pipefail
shopt -s nocasematch 2>/dev/null   # case-insensitive [[ ]] / case — avoids forking `tr` per compare

CAP_HOME="${CAP_HOME:-$HOME/.cap}"
STATE_DIR="$CAP_HOME/state"
EXTRA_LIST="$CAP_HOME/extra.list"
USER_CONF="$CAP_HOME/config.sh"
CPULIMIT_PIDS="$STATE_DIR/cpulimit.pids"
RELAUNCH_LIST="$STATE_DIR/sync_relaunch"   # sync apps cap quit, to relaunch on `off`
mkdir -p "$STATE_DIR"
[ -f "$EXTRA_LIST" ] || : > "$EXTRA_LIST"

# ---------- tunables (override in ~/.cap/config.sh) ----------
CPU_THRESHOLD=20      # %CPU to flag in suggest
MEM_THRESHOLD=5       # %MEM to flag in suggest
NET_THRESHOLD_KB=300  # KB over the sample window to flag a network talker
APP_LIMIT=25          # cpulimit % per core for heavy apps in `call`
RENICE_VAL=18         # nice value applied when soft-capping

# Exact basename match — never touched.
PROTECTED_NAMES="kernel_task launchd WindowServer coreaudiod loginwindow logind \
opendirectoryd bluetoothd powerd watchdogd locationd mds cfprefsd UserEventAgent \
securityd trustd sshd sudo cap cpulimit"

# Path substring match — also never touched (the session itself).
PROTECTED_PATHS=".local/bin/claude Terminal.app iTerm.app"

# Exact basename match — background daemons hard-paused (SIGSTOP) in `call`.
CAP_DAEMONS="mds_stores mdworker mdworker_shared mdbulkimport spotlightknowledged \
knowledgeconstructiond corespotlightd managedcorespotlightd backupd backupd-helper \
photoanalysisd photolibraryd mediaanalysisd cloudd bird AssetCacheLocatorService"

# Path substring match — heavy *background* apps to soft-cap in `call` mode.
# Interactive tools you use during a call (Teams = the call itself, Chrome,
# VS Code) are intentionally excluded so the call/your work isn't throttled.
CAP_APPS="Spotify|Docker|qemu|java"

# Sync clients — QUIT in `call` mode (cleanest "offline"), relaunched on `off`.
SYNC_APPS="owncloud OpenCloud"

[ -f "$USER_CONF" ] && . "$USER_CONF"

# ---------- helpers ----------
have(){ command -v "$1" >/dev/null 2>&1; }
dep_warn(){ have cpulimit || echo "cap: WARNING — cpulimit not installed; CPU caps disabled (renice/pause still work). Install: brew install cpulimit" >&2; }
path_of(){ ps -o comm= -p "$1" 2>/dev/null; }
base_of(){ local p; p="$(path_of "$1")"; [ -n "$p" ] && printf '%s' "${p##*/}"; }
owner_uid(){ ps -o uid= -p "$1" 2>/dev/null | tr -d ' '; }
# run "$@" as the invoking login user (so a `sudo cap` run still acts as you)
as_user(){ local u="${SUDO_USER:-$(id -un)}"; if [ "$(id -u)" = 0 ]; then sudo -u "$u" "$@"; else "$@"; fi; }

# Run a command, escalating to sudo when the target pid ($1) is owned by another user.
priv(){ local pid="$1"; shift; if [ "$(owner_uid "$pid")" != "$(id -u)" ]; then sudo "$@"; else "$@"; fi; }

in_words(){ local v="$1" w; for w in $2; do [[ "$w" == "$v" ]] && return 0; done; return 1; }
path_hits(){ # path, pipe-separated patterns
  local p="$1" IFS='|' pat
  for pat in $2; do [ -n "$pat" ] && [[ "$p" == *"$pat"* ]] && return 0; done
  return 1
}
extra_hits(){ # path  -> matches any line in extra.list
  local p="$1" line
  while IFS= read -r line; do [ -z "$line" ] && continue; [[ "$p" == *"$line"* ]] && return 0; done < "$EXTRA_LIST"
  return 1
}

# PIDs holding a live mic (input) audio assertion = the active call app(s).
call_pids(){ pmset -g assertions 2>/dev/null | awk '/coreaudiod/{c=1} c&&/input.*preventuseridlesleep|input.*context/{f=1} /Created for PID:/{if(f){gsub(/[^0-9]/,"",$NF);print $NF;f=0}}' | sort -u; }
# .app bundles of the call PIDs — so the whole call app (video/screen-share
# renderers too), not just the mic-holding PID, is exempt during a call.
call_bundles(){ local pid p; for pid in $CALL_PIDS; do p="$(path_of "$pid")"; case "$p" in *.app/*) echo "${p%%.app/*}.app";; esac; done | sort -u; }
detect_call(){ CALL_PIDS="$(call_pids)"; CALL_BUNDLES="$(call_bundles)"; }
in_call_bundle(){ local p="$1" b
  while IFS= read -r b; do [ -z "$b" ] && continue; case "$p" in "$b"/*) return 0;; esac; done <<EOF
${CALL_BUNDLES:-}
EOF
  return 1
}

is_protected(){ # pid
  local pid="$1" base path
  [ "$pid" -le 1 ] 2>/dev/null && return 0
  [ "$pid" = "$$" ] || [ "$pid" = "$PPID" ] && return 0
  base="$(base_of "$pid")"; path="$(path_of "$pid")"
  [ -z "$base" ] && return 0                       # vanished -> skip
  in_words "$base" "$PROTECTED_NAMES" && return 0
  path_hits "$path" "$(echo "$PROTECTED_PATHS" | tr ' ' '|')" && return 0
  local p; for p in $CALL_PIDS; do [ "$p" = "$pid" ] && return 0; done
  in_call_bundle "$path" && return 0               # any process of the live call app
  return 1
}

daemon_pids(){ ps -axo pid=,comm= | while read -r pid cmd; do in_words "${cmd##*/}" "$CAP_DAEMONS" && echo "$pid"; done; }
app_pids(){ ps -axo pid=,comm= | while read -r pid cmd; do { path_hits "$cmd" "$CAP_APPS" || extra_hits "$cmd"; } && echo "$pid"; done; }

# ---------- actions ----------
pause_pid(){   priv "$1" kill -STOP "$1" 2>/dev/null; }
resume_pid(){  priv "$1" kill -CONT "$1" 2>/dev/null; }
renice_pid(){  priv "$2" renice "$1" -p "$2" >/dev/null 2>&1; }
limit_pid(){ # pid limit%
  local pid="$1" lim="$2"
  if [ "$(owner_uid "$pid")" != "$(id -u)" ]; then sudo cpulimit -p "$pid" -l "$lim" -i >/dev/null 2>&1 &
  else cpulimit -p "$pid" -l "$lim" -i >/dev/null 2>&1 & fi
  echo "$!" >> "$CPULIMIT_PIDS"
}
drop_all_limits(){ pkill -x cpulimit 2>/dev/null; sudo pkill -x cpulimit 2>/dev/null; : > "$CPULIMIT_PIDS"; }
label(){ local pid="$1" b; b="$(base_of "$pid")"; case "$b" in "")echo "$pid";; *)echo "$b ($pid)";; esac; }

# quit each running sync client (graceful, then force) and remember it for `off`
quit_sync(){
  local app n
  for app in $SYNC_APPS; do
    pgrep -x "$app" >/dev/null 2>&1 || { echo "  $app not running — skipped"; continue; }
    echo "  quitting $app..."
    as_user osascript -e "tell application \"$app\" to quit" >/dev/null 2>&1
    n=0; while pgrep -x "$app" >/dev/null 2>&1 && [ "$n" -lt 8 ]; do sleep 0.5; n=$((n+1)); done
    pgrep -x "$app" >/dev/null 2>&1 && pkill -x "$app" 2>/dev/null
    grep -qxF "$app" "$RELAUNCH_LIST" 2>/dev/null || echo "$app" >> "$RELAUNCH_LIST"
  done
}
# relaunch the sync clients cap quit, then clear the list
relaunch_sync(){
  [ -s "$RELAUNCH_LIST" ] || return 0
  local app
  while IFS= read -r app; do [ -z "$app" ] && continue; echo "  relaunching $app..."; as_user open -a "$app"; done < "$RELAUNCH_LIST"
  : > "$RELAUNCH_LIST"
}

# ---------- modes ----------
mode_call(){
  detect_call
  [ -n "$CALL_PIDS" ] && echo "active call: PID(s) $CALL_PIDS (whitelisted)" || echo "no active call (no live mic) — capping anyway"
  local pid n=0 m=0
  for pid in $(daemon_pids); do
    is_protected "$pid" && continue
    pause_pid "$pid" && { echo "  paused  $(label "$pid")"; n=$((n+1)); }
  done
  for pid in $(app_pids); do
    is_protected "$pid" && continue
    renice_pid "$RENICE_VAL" "$pid"; limit_pid "$pid" "$APP_LIMIT"
    echo "  capped  $(label "$pid") -> ${APP_LIMIT}%"; m=$((m+1))
  done
  quit_sync
  echo "call mode ON — $n daemon(s) paused, $m app(s) capped, sync clients quit. (cap off to release)"
}

mode_off(){
  CALL_PIDS=""; CALL_BUNDLES=""
  local pid n=0
  relaunch_sync
  drop_all_limits
  for pid in $(daemon_pids) $(app_pids); do
    resume_pid "$pid"          # SIGCONT is a no-op if not stopped
    renice_pid 0 "$pid"; n=$((n+1))
  done
  echo "released — resumed/restored $n process(es), caps dropped, sync clients relaunched."
}

mode_status(){
  detect_call
  echo "== paused / capped / busy managed processes =="
  local pid st nice cpu cmd base tag app shown=0 total=0
  while read -r pid st nice cpu cmd; do
    [ -z "${pid:-}" ] && continue
    base="${cmd##*/}"
    in_words "$base" "$CAP_DAEMONS" || path_hits "$cmd" "$CAP_APPS" || extra_hits "$cmd" || continue
    total=$((total+1))
    case "$st" in
      *T*) tag="PAUSED " ;;
      *) if [ "${cpu%%.*}" -ge 2 ] 2>/dev/null; then tag="busy   "
         elif [ "${nice:-0}" -gt 0 ] 2>/dev/null; then tag="niced  "
         else continue; fi ;;
    esac
    printf "  [%s] %-44s cpu=%s%% nice=%s\n" "$tag" "$base ($pid)" "$cpu" "$nice"
    shown=$((shown+1))
  done <<EOF
$(ps -axo pid=,state=,nice=,pcpu=,comm=)
EOF
  echo "  ($shown shown of $total managed-eligible; rest idle/unchanged)"
  echo "active call PID(s): ${CALL_PIDS:-none}"
  echo "cpulimit daemons running: $(pgrep -x cpulimit | wc -l | tr -d ' ')"
  local s=""; for app in $SYNC_APPS; do pgrep -x "$app" >/dev/null 2>&1 && s="$s $app(running)" || s="$s $app(quit)"; done
  echo "sync clients:${s:- none}"
}

suggest_once(){
  detect_call
  echo "== hogs over thresholds (cpu>=${CPU_THRESHOLD}% or mem>=${MEM_THRESHOLD}%) =="
  ps -axo pid=,pcpu=,pmem=,comm= -r | while read -r pid cpu mem cmd; do
    { [ "${cpu%%.*}" -ge "$CPU_THRESHOLD" ] || [ "${mem%%.*}" -ge "$MEM_THRESHOLD" ]; } 2>/dev/null || continue
    is_protected "$pid" && continue          # protected procs are never actionable — hide them
    if in_words "${cmd##*/}" "$CAP_DAEMONS" || path_hits "$cmd" "$CAP_APPS" || extra_hits "$cmd"; then
      printf "  managed    %-34s cpu=%s%% mem=%s%%\n" "${cmd##*/}" "$cpu" "$mem"
    else
      printf "  SUGGEST    %-34s cpu=%s%% mem=%s%%   -> cap add \"%s\"\n" "${cmd##*/}" "$cpu" "$mem" "${cmd##*/}"
    fi
  done
  echo "== network talkers over ${NET_THRESHOLD_KB}KB/sample =="
  nettop -P -n -x -d -l 2 -J bytes_in,bytes_out 2>/dev/null | tail -n +2 | awk -v t=$((NET_THRESHOLD_KB*1024)) \
    'NF>=3{a[$1]=$(NF-1)+$NF} END{for(k in a) if(a[k]>t) printf "  %-44s %d KB\n",k,a[k]/1024}' | sort -k2 -nr | head -8
}

# Install a sudoers drop-in so `cap call`/`cap off` run without a password.
# Only NOPASSWDs process-control commands (no file writes) for the invoking user.
mode_setup(){
  local u tmp sudoers=/etc/sudoers.d/cap
  u="${SUDO_USER:-$(id -un)}"
  echo "installing NOPASSWD sudoers drop-in for user '$u' (needs sudo once)..."
  tmp="$(mktemp)"
  printf '%s ALL=(root) NOPASSWD: /bin/kill, /usr/bin/renice, /usr/bin/pkill, /usr/local/bin/cpulimit\n' "$u" > "$tmp"
  if sudo visudo -cf "$tmp" >/dev/null 2>&1; then
    sudo install -m 440 -o root -g wheel "$tmp" "$sudoers" && echo "  installed $sudoers — '$u' can now run 'cap call' / 'cap off' without a password"
  else
    echo "  ERROR: generated sudoers failed validation; not installed"
  fi
  rm -f "$tmp"
}

dep_warn
case "${1:-help}" in
  call)     mode_call ;;
  off)      mode_off ;;
  setup)    mode_setup ;;
  status)   mode_status ;;
  suggest)  if [ -n "${2:-}" ]; then while true; do clear 2>/dev/null; date "+%H:%M:%S"; suggest_once; sleep "$2"; done
            else suggest_once; fi ;;
  add)      shift; [ -z "${1:-}" ] && { echo "usage: cap add <path-or-name-substring>"; exit 1; }
            echo "$*" >> "$EXTRA_LIST"; echo "added to cap list: $*  ($EXTRA_LIST)" ;;
  list)     echo "PROTECTED — never touched:"
            echo "  names: $PROTECTED_NAMES"
            echo "  paths: $PROTECTED_PATHS"
            echo "  + the live call app's whole bundle (auto-detected via mic assertion)"
            echo
            echo "mode 'call' — quiet things for a call:"
            echo "  daemons (paused):        $CAP_DAEMONS"
            echo "  heavy apps (cpu-capped): ${CAP_APPS//|/, }"
            echo "  extra (cpu-capped):      $(tr '\n' ' ' < "$EXTRA_LIST")"
            echo "  sync clients (quit):     $SYNC_APPS   (relaunched on 'cap off')" ;;
  help|-h|--help) sed -n '3,15p' "$0" | sed 's/^#//;s/^ //' ;;
  *)        echo "unknown mode: $1"; echo "try: cap help"; exit 1 ;;
esac
